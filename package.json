{
  "name": "pi-subagents",
  "version": "0.1.0",
  "description": "ORGM Pi subagents package.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osmargm1202/pi-subagents.git"
  },
  "bugs": {
    "url": "https://github.com/osmargm1202/pi-subagents/issues"
  },
  "homepage": "https://github.com/osmargm1202/pi-subagents#readme",
  "keywords": [
    "pi-package",
    "pi-extension",
    "orgm",
    "subagents"
  ],
  "files": [
    "agents",
    "archive",
    "extensions",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./extensions/subagents.ts",
      "./extensions/agent-status.ts"
    ],
    "prompts": [
      "./agents"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "typebox": "^1.0.55"
  }
